{
  "name": "doaps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automação de APS no AVA (Moodle) da UniEVANGÉLICA com Playwright + IA",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node --env-file=.env src/cli.ts",
    "dry-run": "node --env-file=.env src/cli.ts --dry-run",
    "offline": "node --env-file=.env src/cli.ts --offline",
    "eval": "node --env-file=.env eval/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.spec.ts\"",
    "browser:check": "node src/core/browser-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.0"
  }
}
