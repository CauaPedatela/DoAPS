# ══════════════════════════════════════════════════════════════════════
#  doAPS — configuração
#  Copie para `.env` e preencha.  O `.env` NUNCA é commitado.
# ══════════════════════════════════════════════════════════════════════

# ─── Moodle / AVA UniEVANGÉLICA ───────────────────────────────────────
MOODLE_URL=https://avagrad.unievangelica.edu.br
MOODLE_USERNAME=
MOODLE_PASSWORD=

# ─── Provedor de IA ───────────────────────────────────────────────────
# 'gemini' (free tier) | 'claude'
AI_PROVIDER=gemini

# Chave do Gemini — grátis, sem cartão: https://aistudio.google.com/apikey
# ⚠ No free tier o Google PODE usar seus prompts para treinar os modelos
#    deles e avaliadores humanos podem revisar. Ver docs/ARQUITETURA.md §3.1
GEMINI_API_KEY=

# Só necessária se AI_PROVIDER=claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# gemini-3.8-flash | gemini-3.5-flash | claude-opus-5 | claude-haiku-4-5
AI_MODEL=gemini-3.8-flash

# Modelos alternativos quando o principal devolve 503 ("high demand").
# O free tier satura POR MODELO: insistir no mesmo nao resolve.
AI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash

# ─── Segurança operacional ────────────────────────────────────────────
# Piso de tempo por questionário, em minutos.
# Impede que uma prova de 10 questões seja enviada em 40 segundos —
# o professor enxerga isso no log do Moodle. Ver §8.
MIN_QUIZ_MINUTES=8

# Não abrir tentativa se faltar menos que isto para o prazo (minutos)
DEADLINE_MARGIN_MINUTES=120

# ─── Agendador (npm run daemon) ───────────────────────────────────────
# Horário diário, HH:MM, no fuso local da máquina
DAEMON_HORA=07:20

# Regra fixa: o robo so executa APS SEM nenhuma tentativa feita.
# O que voce ja fez nao e refeito, nem que sobrem tentativas.
#
# true = envia de fato. false = preenche e deixa aberta para voce revisar.
DAEMON_SUBMIT=false


# ─── Execução ─────────────────────────────────────────────────────────
# Navegador: usa o Chrome JÁ INSTALADO na máquina (sem baixar 150MB
# e com fingerprint mais autêntico). Alternativas: msedge, chromium
BROWSER_CHANNEL=chrome

# true = navegador visível (recomendado enquanto você desenvolve)
HEADED=true
LOG_LEVEL=info
